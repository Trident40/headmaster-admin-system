{
  "name": "hmp-headmaster",
  "version": "1.1.0",
  "private": true,
  "author": "ArcaneMP Server Developer",
  "description": "Interactive Discord-ID Headmaster Administration Panel for ArcaneMP Foundations (players, bans, House Cup, force re-sorting, spells, gear, world weather/time, and staff roster).",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline && esbuild client/index.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js",
      "ui/index.html",
      "ui/style.css",
      "ui/app.js"
    ],
    "exports": [
      "staff",
      "bans",
      "audit"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-lib",
        "version": "0.12.0"
      },
      {
        "name": "hmp-core",
        "version": "0.12.0"
      },
      {
        "name": "hmp-houses",
        "version": "0.12.0"
      },
      {
        "name": "hmp-inventory",
        "version": "0.12.0"
      },
      {
        "name": "hmp-ui",
        "version": "0.12.0"
      }
    ],
    "errorBehavior": "stop",
    "priority": -300
  }
}